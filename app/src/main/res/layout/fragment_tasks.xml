<?xml version="1.0" encoding="utf-8"?>
<!-- 任务中心：顶栏 + 状态筛选 + 任务列表 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:backgroundTint="@color/light_gray"
    tools:context=".ui.tasks.TasksFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="15dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@color/navy">

        <TextView
            android:id="@+id/tvProjectName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/short_test"
            android:textColor="@color/white"
            android:layout_marginTop="10dp"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <ImageView
            android:id="@+id/btnNotification"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_oval"
            android:clickable="true"
            android:contentDescription="@string/notification"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/ic_bell"
            app:layout_constraintBottom_toBottomOf="@+id/tvProjectName"
            app:layout_constraintRight_toRightOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:id="@+id/tvMyTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="我的任务"
        android:paddingStart="16dp"
        android:textColor="@color/text_primary"
        android:layout_marginTop="10dp"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <TextView
        android:id="@+id/tvTaskMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="更多任务 ▶ "
        android:textColor="@color/teal"
        android:layout_marginTop="15dp"
        android:textSize="20sp"
        android:layout_marginRight="20dp"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintRight_toRightOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTaskList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingStart="16dp"
            app:layout_constraintTop_toBottomOf="@+id/tvMyTask"/>
    <TextView
        android:id="@+id/tvAgent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="最近动态"
        android:textSize="20dp"
        android:textStyle="bold"
        android:paddingStart="16dp"
        android:layout_marginTop="10dp"
        app:layout_constraintLeft_toLeftOf="@+id/rvTaskList"
        app:layout_constraintTop_toBottomOf="@+id/rvTaskList"
        android:textColor="@color/deep_blue" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAgentTaskList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingStart="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tvAgent"/>
    <TextView
        android:id="@+id/tvMR"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MR查看"
        android:paddingStart="16dp"
        android:textColor="@color/text_primary"
        android:layout_marginTop="10dp"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/rvAgentTaskList"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <TextView
        android:id="@+id/tvMRMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="更多MR ▶ "
        android:textColor="@color/teal"
        android:layout_marginTop="15dp"
        android:textSize="20sp"
        android:layout_marginRight="20dp"
        app:layout_constraintTop_toBottomOf="@+id/rvAgentTaskList"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMRList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingStart="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tvMR"/>


</androidx.constraintlayout.widget.ConstraintLayout>
