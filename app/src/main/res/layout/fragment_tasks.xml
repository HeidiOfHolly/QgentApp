<?xml version="1.0" encoding="utf-8"?>
<!-- 任务中心：顶栏（固定）+ 内容区（ScrollView > LinearLayout，三个列表整体滚动） -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:backgroundTint="@color/light_gray"
    tools:context=".ui.tasks.TasksFragment">

    <!-- 顶栏：固定不动 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="15dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@color/navy">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent">

            <TextView
                android:id="@+id/tvTeamName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/blue_tint"
                android:textStyle="bold"
                android:textSize="15sp"
                tools:text="团队A" />

            <TextView
                android:id="@+id/tvProjectName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/short_test"
                android:textColor="@color/white"
                android:textSize="25sp"
                android:textStyle="bold"
                tools:text="登录项目" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:layout_marginRight="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/btnNewTask">
            <ImageView
                android:id="@+id/btnNotification"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_oval"
                android:clickable="true"
                android:contentDescription="@string/notification"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_bell" />
            <View
                android:id="@+id/ivInviteBadge"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_unread_badge"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>
        <ImageView
            android:id="@+id/btnNewTask"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_oval"
            android:clickable="true"
            android:contentDescription="新建任务"
            android:layout_marginBottom="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/ic_add" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 内容区：整页滚动（下拉刷新容器包裹） -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintBottom_toBottomOf="parent">

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- ── 任务列表区块 ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp">

                <ImageView
                    android:id="@+id/ivTask"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_task"
                    app:tint="@color/navy_light" />

                <TextView
                    android:id="@+id/tvMyTask"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="任务列表"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvTaskMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="更多任务 ▶ "
                    android:textColor="@color/teal"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTaskEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginVertical="20dp"
                android:text="💻 暂无任务"
                android:textSize="18dp"
                android:textColor="@color/text_secondary"
                 />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTaskList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingStart="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"/>


            <!-- ── 最近动态区块 ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp">

                <ImageView
                    android:id="@+id/ivDone"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_done"
                    app:tint="@color/navy_light" />

                <TextView
                    android:id="@+id/tvAgent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="5dp"
                    android:text="最近动态"
                    android:textColor="@color/charcoal"
                    android:textSize="20dp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvAgentEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginVertical="15dp"
                android:text="🤖 暂无最近动态"
                android:textSize="15dp"
                android:textColor="@color/text_secondary" />

            <ProgressBar
                android:id="@+id/pbActivitiesLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="15dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAgentTaskList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingTop="4dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp" />


            <!-- ── MR查看区块 ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp">

                <ImageView
                    android:id="@+id/ivMR"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_mr"
                    app:tint="@color/navy_light" />

                <TextView
                    android:id="@+id/tvMR"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="5dp"
                    android:text="合并请求"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvMRMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="更多合并请求 ▶ "
                    android:textColor="@color/teal"
                    android:textSize="15sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvMREmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="20dp"
                android:layout_marginStart="16dp"
                android:text="📒 暂无合并请求"
                android:textSize="18sp"
                android:textColor="@color/text_secondary" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMRList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingTop="4dp"
                android:paddingStart="16dp"
                android:paddingEnd="10dp" />

        </LinearLayout>
    </ScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
