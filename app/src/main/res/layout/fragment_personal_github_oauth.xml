<?xml version="1.0" encoding="utf-8"?>
<!-- 个人 GitHub OAuth 绑定页（§50）：状态展示 + 发起绑定 + 撤销；WebView 承载 GitHub 授权流程 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    tools:context=".ui.github.PersonalGithubOAuthFragment">

    <!-- ===== 顶部栏 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/ivBack"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_back"
            app:tint="@color/blue_tint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/personal_github_oauth_title"
            android:textColor="@color/blue_tint"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 状态/操作区：未绑定 → 去绑定；已绑定 → 账号信息 + 撤销 -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_oval"
                    android:backgroundTint="@color/charcoal"
                    android:contentDescription="@string/personal_github_oauth_icon_desc"
                    android:padding="16dp"
                    app:srcCompat="@drawable/ic_github" />

                <TextView
                    android:id="@+id/tvStatusTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_horizontal"
                    android:text="@string/personal_github_oauth_unauthorized_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_horizontal"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/personal_github_oauth_unauthorized_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- personalRepositorySetup 前置状态引导（非 READY 时展示） -->
                <TextView
                    android:id="@+id/tvSetupHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_horizontal"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/red_danger"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="个人建仓需要团队 Owner 权限"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bnBind"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:minHeight="52dp"
                    android:text="@string/personal_github_oauth_bind_action"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/navy_light"
                    app:cornerRadius="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_horizontal"
                    android:text="@string/personal_github_oauth_bind_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- 已授权信息区（authorized=true 显示） -->
                <LinearLayout
                    android:id="@+id/authorizedSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_card"
                    android:backgroundTint="@color/white"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvGithubLogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:textColor="@color/charcoal"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGithubScopes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_horizontal"
                        android:textColor="@color/gray"
                        android:textSize="13sp"
                        tools:text="授权范围：私有与公开仓库" />

                    <TextView
                        android:id="@+id/tvGithubAuthorizedAt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_horizontal"
                        android:textColor="@color/gray"
                        android:textSize="12sp"
                        tools:text="绑定时间：2026-08-20T14:30:00Z" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bnRevoke"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="52dp"
                    android:text="@string/personal_github_oauth_revoke"
                    android:textColor="@color/red_danger"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/red_danger"
                    app:strokeWidth="1dp" />

                <!-- 状态查询中 -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="32dp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <!-- 承载 GitHub OAuth 授权流程的 WebView：可拦截后端回跳并解析 githubOAuth 参数，
             初始隐藏，点击「去绑定 GitHub」后显示 -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
