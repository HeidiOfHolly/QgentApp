<?xml version="1.0" encoding="utf-8"?>
<!-- 我管理的团队详情：顶部栏(返回+团队名) + 管理成员/管理项目下拉分组 + 底部解散团队 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    tools:context=".ui.personal.TeamDetailFragment">

    <!-- ===== 顶部栏 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/ivBack"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_back"
            app:tint="@color/blue_tint" />

        <TextView
            android:id="@+id/tvTeamName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
            android:textColor="@color/blue_tint"
            android:textStyle="bold"
            tools:text="团队A" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- ===== 分组一：管理成员（默认收起） ===== -->
            <LinearLayout
                android:id="@+id/headerMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="@color/navy_light"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/ivArrowMembers"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/manage_members"
                    android:rotation="90"
                    android:src="@drawable/ic_triangle"
                    app:tint="@color/blue_tint" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/manage_members"
                    android:textColor="@color/blue_tint"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 成员分组内容：顶部增加按钮 + 成员列表（默认收起） -->
            <LinearLayout
                android:id="@+id/sectionMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddMember"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="8dp"
                    android:minHeight="44dp"
                    android:text="@string/add_member"
                    android:textColor="@color/teal"
                    android:textSize="15sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/teal"
                    app:strokeWidth="1dp" />

                <LinearLayout
                    android:id="@+id/containerMembers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:background="@color/divider" />

            <!-- ===== 分组二：管理项目（默认收起） ===== -->
            <LinearLayout
                android:id="@+id/headerProjects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="@color/navy_light"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/ivArrowProjects"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/manage_projects"
                    android:rotation="90"
                    android:src="@drawable/ic_triangle"
                    app:tint="@color/blue_tint" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/manage_projects"
                    android:textColor="@color/blue_tint"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 项目分组内容：顶部增加按钮 + 项目列表（默认收起） -->
            <LinearLayout
                android:id="@+id/sectionProjects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddProject"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="8dp"
                    android:minHeight="44dp"
                    android:text="@string/add_project"
                    android:textColor="@color/teal"
                    android:textSize="15sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/teal"
                    app:strokeWidth="1dp" />

                <LinearLayout
                    android:id="@+id/containerProjects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp" />
            </LinearLayout>

            <!-- ===== 解散团队 ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDissolveTeam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="32dp"
                android:minHeight="52dp"
                android:text="@string/dissolve_team"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/red_danger"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
