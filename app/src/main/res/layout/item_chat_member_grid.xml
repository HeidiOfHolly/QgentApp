<?xml version="1.0" encoding="utf-8"?>
<!-- 聊天设置成员网格子项：纵向 头像 / 名称 / 身份；删除角标默认隐藏（删除模式显示） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivMemberAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_oval"
            android:backgroundTint="@color/bg_chat_pinned"
            android:contentDescription="@string/avatar"
            android:src="@drawable/ic_avatar_default"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvMemberName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            tools:text="张三" />

        <!-- 身份：Agent 显示「Agent」，真人隐藏 -->
        <TextView
            android:id="@+id/tvMemberRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_status_tag"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:text="Agent"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- 删除角标：删除模式下显示，点击移除该成员 -->
    <ImageView
        android:id="@+id/ivDeleteMember"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:background="@drawable/bg_oval"
        android:backgroundTint="@color/exit_red"
        android:contentDescription="@string/remove_member"
        android:padding="4dp"
        android:src="@drawable/ic_close"
        app:tint="@color/off_white"
        android:visibility="gone"
        tools:visibility="visible" />
</FrameLayout>
