<?xml version="1.0" encoding="utf-8"?>
<!-- MR 展示卡片：仓库 + 分支群 + 状态 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="5dp"
    android:background="@drawable/bg_card"
    android:backgroundTint="@color/white"
    android:elevation="5dp"
    android:paddingHorizontal="15dp"
    android:paddingVertical="13dp">

    <TextView
        android:id="@+id/tvMrRepo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/tvMrStatus"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="auth-service" />

    <TextView
        android:id="@+id/tvMrStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_tag"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="进行中" />

    <TextView
        android:id="@+id/tvMrBranches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvMrRepo"
        tools:text="feature/login-api → main" />
</androidx.constraintlayout.widget.ConstraintLayout>
