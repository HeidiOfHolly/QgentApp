<?xml version="1.0" encoding="utf-8"?>
<!-- 交付物卡片（交付中心 / 交付物列表共用）：标题 + 仓库 + Diff 统计 + Review/Delivery + 逐仓库进度 + 操作行 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 标题行：标题 + MR 状态标签 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="(T-76) 实现邮箱登录" />

        <!-- 是否已创建 MR 标签 -->
        <TextView
            android:id="@+id/tvMrLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_status_tag"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="已创建 MR" />
    </LinearLayout>

    <!-- 仓库 / 分支 -->
    <TextView
        android:id="@+id/tvRepos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/slate_gray"
        android:textSize="15sp"
        tools:text="📦 qgents-web / feat/login" />

    <!-- Review / Delivery 状态 -->
    <TextView
        android:id="@+id/tvReviewDelivery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        tools:text="Review ACCEPTED · Delivery DELIVERED" />

    <!-- 逐仓库交付状态（动态填充） -->
    <LinearLayout
        android:id="@+id/containerRepos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- 操作行（动态填充：查看 Diff / 确认交付 / 拒绝 / 重试） -->
    <LinearLayout
        android:id="@+id/containerActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal" />
</LinearLayout>
