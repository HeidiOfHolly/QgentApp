<?xml version="1.0" encoding="utf-8"?>
<!-- MR diff 文件项：文件头 + 代码行列表 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:elevation="3dp"
    android:background="@drawable/bg_card"
    android:backgroundTint="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvDiffFileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="src/main/LoginService.java" />

        <TextView
            android:id="@+id/tvDiffStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="+12 -3" />
    </LinearLayout>


    <!-- 代码区横向滚动：长代码行不截断，横向滑动查看完整内容；竖向滚动由详情页外层 ScrollView 承担。
         fillViewport=true：短文件代码区铺满屏宽，长文件按内容宽撑开触发横向滚动 -->
    <HorizontalScrollView
        android:id="@+id/scrollDiffLines"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="horizontal"
        android:overScrollMode="ifContentScrolls">

        <!-- 代码行容器：逐行 inflate item_mr_diff_line；宽度为 wrap_content 以容纳超屏宽的长行 -->
        <LinearLayout
            android:id="@+id/containerDiffLines"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </HorizontalScrollView>
</LinearLayout>
