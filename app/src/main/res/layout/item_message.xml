<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <!-- 多选模式复选框：固定最左端（不复选时隐藏），不随消息对齐方向变化 -->
    <CheckBox
        android:id="@+id/cbMultiSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/rowContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="horizontal">

    <!-- 消息头像：圆形裁剪（自己消息由代码移到气泡右侧，间距也由代码调整） -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_avatar"
        android:contentDescription="@string/user_name_placeholder"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_avatar_default"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Avatar"
        app:strokeColor="@color/white"
        app:strokeWidth="1dp" />

    <LinearLayout
        android:id="@+id/rowInner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="start"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="张三" />

            <!-- Agent 消息标识 -->
            <TextView
                android:id="@+id/tvAgentTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_status_tag"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingTop="1dp"
                android:paddingEnd="5dp"
                android:paddingBottom="1dp"
                android:text="Agent"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- 引用消息摘要：气泡上方小灰字，被引用消息时显示 -->
        <TextView
            android:id="@+id/tvQuoteSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_status_review"
            android:ellipsize="end"
            android:maxWidth="260dp"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="回复 @张三：今天把登录接口联调一下"
            tools:visibility="visible" />

        <!-- 气泡行：发送状态指示（仅自己消息显示）+ 气泡 -->
        <LinearLayout
            android:id="@+id/llBubbleRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 发送中：小加载标 -->
            <ProgressBar
                android:id="@+id/pbSendLoading"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <!-- 发送失败：红色感叹号，点击可重发/删除 -->
            <TextView
                android:id="@+id/tvSendFailed"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_circle_red"
                android:gravity="center"
                android:text="!"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/flBubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvBubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:maxWidth="280dp"
                    android:paddingStart="15dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="15dp"
                    android:paddingBottom="10dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                    tools:text="今天把登录接口联调一下" />

                <ImageView
                    android:id="@+id/ivBubbleImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/image"
                    android:minHeight="100dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <!-- 图片加载中：居中加载态，加载完成/失败后隐藏 -->
                <ProgressBar
                    android:id="@+id/pbImageLoading"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/llBubbleFile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="15dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="15dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivFileIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/file"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_folder" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvFileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:maxWidth="200dp"
                            android:singleLine="true"
                            android:textSize="15sp"
                            tools:text="需求文档.pdf" />

                        <TextView
                            android:id="@+id/tvFileSize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            tools:text="2.3 MB" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>

</LinearLayout>