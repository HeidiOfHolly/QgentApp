<?xml version="1.0" encoding="utf-8"?>
<!-- 个人中心抽屉内容：左侧团队栏（navy）+ 右侧个人主页（off_white） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/off_white"
    android:orientation="horizontal"
    tools:context=".ui.personal.PersonalCenterFragment">

    <!-- ===== 左侧团队栏 ===== -->
    <LinearLayout
        android:layout_width="90dp"
        android:layout_height="match_parent"
        android:background="@color/navy"
        android:orientation="vertical"
        android:paddingTop="48dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTeamManage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:minHeight="40dp"
            android:text="@string/team_manage"
            android:textColor="@color/mint"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/navy_light"
            app:cornerRadius="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp"
            android:text="我的团队"
            android:textColor="#8896AE"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTeams"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp" />
    </LinearLayout>

    <!-- ===== 右侧个人主页 ===== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/off_white"
        android:orientation="vertical"
        android:paddingTop="40dp">

        <!-- 个人名片卡片 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card"
            android:paddingVertical="10dp"
            android:paddingHorizontal="8dp">

            <ImageView
                android:id="@+id/btnAvatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_person"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintLeft_toRightOf="@+id/btnAvatar"
                app:layout_constraintRight_toLeftOf="@+id/btnNotification"
                app:layout_constraintTop_toTopOf="@+id/btnAvatar">

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/charcoal"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="张三" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="当前团队："
                    android:textColor="@color/gray"
                    android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvTeamName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gray"
                android:textSize="12sp"
                tools:text="团队A"
                app:layout_constraintTop_toBottomOf="@+id/card"
                app:layout_constraintLeft_toLeftOf="@+id/card"/>
            <ImageView
                android:id="@+id/btnNotification"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_oval"
                android:clickable="true"
                android:contentDescription="@string/notification"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_bell"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/btnAvatar" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 项目列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProjects"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical" />

    </LinearLayout>

</LinearLayout>
