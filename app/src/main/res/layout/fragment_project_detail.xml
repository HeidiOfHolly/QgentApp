<?xml version="1.0" encoding="utf-8"?>
<!-- 项目详情：顶部栏(返回+项目名) + 项目信息(头像/名称/简介) + 成员/仓库下拉分组(默认收起) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray"
    android:orientation="vertical"
    tools:context=".ui.personal.ProjectDetailFragment">

    <!-- ===== 顶部栏 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="15dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/ivBack"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_back"
            app:tint="@color/blue_tint" />

        <TextView
            android:id="@+id/tvProjectName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/project_detail_title"
            android:textColor="@color/blue_tint"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- ===== 项目信息区：头像 + 名称 + 简介 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/ivProjectAvatar"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_oval"
                    android:backgroundTint="@color/deep_blue"
                    android:contentDescription="@string/project_avatar"
                    android:padding="14dp"
                    android:src="@drawable/ic_group"
                    app:tint="@color/blue_tint" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProjectDetailName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="Qgents Web" />

                    <TextView
                        android:id="@+id/tvProjectDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        tools:text="Web client 描述" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:background="@color/divider" />

            <!-- ===== 分组一：成员（默认收起） ===== -->
            <LinearLayout
                android:id="@+id/headerMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="@color/navy_light"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/ivArrowMembers"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:contentDescription="@string/manage_members"
                    android:rotation="90"
                    android:src="@drawable/ic_triangle"
                    app:tint="@color/blue_tint" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/project_members"
                    android:textColor="@color/blue_tint"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- 成员管理菜单（仅团长/管理员可见）：添加成员 / 添加管理员 -->
                <ImageView
                    android:id="@+id/ivMembersMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="成员管理"
                    android:src="@drawable/ic_more"
                    app:tint="@color/blue_tint"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 成员分组内容：成员列表（默认收起） -->
            <LinearLayout
                android:id="@+id/sectionMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvMembersEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:text="@string/project_members_empty"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/rvMembers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:background="@color/divider" />

            <!-- ===== 分组二：已绑定仓库（默认收起） ===== -->
            <LinearLayout
                android:id="@+id/headerRepositories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="@color/navy_light"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/ivArrowRepositories"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:contentDescription="@string/manage_repositories"
                    android:rotation="90"
                    android:src="@drawable/ic_triangle"
                    app:tint="@color/blue_tint" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/project_repositories"
                    android:textColor="@color/blue_tint"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- 绑定仓库（仅项目管理员可见） -->
                <ImageView
                    android:id="@+id/tvAddRepository"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:textColor="@color/teal"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:src="@drawable/ic_add"
                    app:tint="@color/teal"
                    android:visibility="gone"
                    android:background="@drawable/bg_avatar"
                    android:backgroundTint="@color/blue_tint"/>
            </LinearLayout>

            <!-- 仓库分组内容：已绑定仓库列表（默认收起） -->
            <LinearLayout
                android:id="@+id/sectionRepositories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvRepositoriesEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:text="@string/project_repositories_empty"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/rvRepositories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 退出项目（仅普通成员可见；团长/管理员隐藏） -->
            <TextView
                android:id="@+id/tvExitProject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="@color/exit_red"
                android:gravity="center"
                android:paddingVertical="14dp"
                android:text="退出项目"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
